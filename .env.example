# Dummy development values. Copy to .env (make dev-up does this). Never commit .env.
POSTGRES_USER=spillway
POSTGRES_PASSWORD=spillway-dev-password
POSTGRES_DB=spillway
MQTT_DEVICE_PASSWORD=device-dev-password
MQTT_SERVICE_PASSWORD=service-dev-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password

# Host ports (all bound to 127.0.0.1)
POSTGRES_PORT=5432
REDIS_PORT=6379
MQTT_PORT=1883
KEYCLOAK_PORT=8081

# Spillway binary (host-run during development)
DATABASE_URL=postgres://spillway:spillway-dev-password@127.0.0.1:5432/spillway?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
# 32 random bytes, base64. Generate your own: openssl rand -base64 32
SPILLWAY_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SPILLWAY_HTTP_ADDR=127.0.0.1:8080
SPILLWAY_LOG_LEVEL=info
# Ingest over MQTT (leave MQTT_URL empty for HTTP-only). The service account may only read telemetry.
MQTT_URL=tcp://127.0.0.1:1883
MQTT_USERNAME=spillway
MQTT_PASSWORD=service-dev-password
# "dev" enables dev-only commands such as seed-dev; the default is production.
SPILLWAY_ENV=dev
# Raw readings are kept this long (7..3650 days); aggregates are kept.
SPILLWAY_RAW_RETENTION_DAYS=90
# Key rotation: bump the version, and list previous keys as "version:base64,version:base64".
SPILLWAY_SECRET_KEY_VERSION=1
# SPILLWAY_SECRET_KEY_OLD=

# Basemap tiles (web). Default OSM tiles: demo scale only, see README.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Telegram bot (see docs/TELEGRAM.md). Leave the token empty to run without notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Base URL of the public pages, used for links in alert messages (no trailing slash).
PUBLIC_BASE_URL=http://localhost:3000

# OIDC (Keycloak). Without OIDC_ISSUER the admin API is disabled.
OIDC_ISSUER=http://localhost:8081/realms/spillway-dev
OIDC_AUDIENCE=spillway-api
BOOTSTRAP_ADMIN_EMAIL=admin@spillway.dev
DEFAULT_ORG_SLUG=dev
CORS_ORIGINS=http://localhost:3000
# Set to true only behind a trusted reverse proxy (Caddy) that appends X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Web (SvelteKit, web/). Read when the web server starts; run it with the same environment (make web-dev).
# API as the web server reaches it, and as BROWSERS reach it (live stream, chart ranges; defaults to API_URL).
API_URL=http://127.0.0.1:8080
PUBLIC_API_URL=http://127.0.0.1:8080
# Public OIDC client (code flow + PKCE). OIDC_ISSUER above is reused by the web server.
OIDC_CLIENT_ID=spillway-web
TILE_ATTRIBUTION=© OpenStreetMap contributors
# Production: ORIGIN=https://your.host PORT=3000 ADDRESS_HEADER=X-Forwarded-For XFF_DEPTH=1 (behind Caddy).
# The API must then run with TRUST_PROXY_HEADERS=true so per-IP rate limits see visitors, not the web server.
