# Production values. Copy to deploy/compose/.env.prod (git-ignored) and replace every CHANGE_ME.
# Generate secrets with: openssl rand -hex 24   (SPILLWAY_SECRET_KEY: openssl rand -base64 32)

# Public name: DNS A records for DOMAIN and auth.DOMAIN must point at this server.
DOMAIN=spillway.example.org
PUBLIC_SCHEME=https
ACME_EMAIL=you@example.org

POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
MQTT_DEVICE_PASSWORD=CHANGE_ME
MQTT_SERVICE_PASSWORD=CHANGE_ME

# 32 random bytes, base64. LOSING IT MAKES EVERY DEVICE SECRET UNREADABLE: back it up separately.
SPILLWAY_SECRET_KEY=CHANGE_ME
SPILLWAY_SECRET_KEY_VERSION=1
# SPILLWAY_SECRET_KEY_OLD=1:base64oldkey
SPILLWAY_RAW_RETENTION_DAYS=90

# The first verified sign-in with this e-mail becomes admin of DEFAULT_ORG_SLUG (create it first, docs/DEPLOY.md).
BOOTSTRAP_ADMIN_EMAIL=you@example.org
DEFAULT_ORG_SLUG=main

# Telegram (docs/TELEGRAM.md). Empty token: alerts are stored but nothing is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Basemap. The default OSM tile server is for demo scale only (usage policy); use your own provider for real traffic.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors

# MQTT exposure. TLS (8883) is enabled when MQTT_CERT_DIR holds fullchain.pem and privkey.pem.
# MQTT_CERT_DIR=./certs
MQTT_TLS_BIND=0.0.0.0
MQTT_PLAIN_BIND=127.0.0.1

# Optional resource limits
# POSTGRES_MEM_LIMIT=2g
# SPILLWAY_MEM_LIMIT=1g
