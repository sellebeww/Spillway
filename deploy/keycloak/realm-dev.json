{
  "realm": "spillway-dev",
  "displayName": "Spillway (DEV ONLY, never use in production)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Informational only: authorization comes from Spillway memberships, not token roles" },
      { "name": "operator", "description": "Informational only: authorization comes from Spillway memberships, not token roles" }
    ]
  },
  "clients": [
    {
      "clientId": "spillway-web",
      "name": "Spillway web (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "spillway-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "spillway-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "org-claim-dev",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "org", "claim.value": "dev", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.dev",
      "email": "admin@spillway.dev",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dev-admin-password", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "operator.dev",
      "email": "operator@spillway.dev",
      "emailVerified": true,
      "firstName": "Operator",
      "lastName": "Dev",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dev-operator-password", "temporary": false }],
      "realmRoles": ["operator"]
    }
  ]
}
